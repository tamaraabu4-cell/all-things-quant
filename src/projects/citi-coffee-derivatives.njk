    <div class="chart-control-row"><span class="cc-label">Futures price</span><input type="range" id="b-f" min="1.00" max="1.50" step="0.0001" value="1.2181"><span class="cc-value" id="b-f-v">$1.2181</span></div>
    <div class="chart-control-row"><span class="cc-label">Volatility</span><input type="range" id="b-v" min="10" max="50" step="1" value="25"><span class="cc-value" id="b-v-v">25%</span></div>
    <div class="chart-control-row"><span class="cc-label">Months left</span><input type="range" id="b-t" min="1" max="12" step="1" value="6"><span class="cc-value" id="b-t-v">6</span></div>
  </div>
