<script>
const $=id=>document.getElementById(id);
const isDark=()=>document.documentElement.getAttribute('data-theme')==='dark';
const charts={};
const N=6;
function switchTopic(n){
  for(let i=1;i<=N;i++){const p=$('topic-'+i),s=$('sb-'+i);if(p)p.style.display=(i===n?'block':'none');if(s)s.classList.toggle('active',i===n);}
  window.scrollTo({top:0,behavior:'smooth'});document.querySelector('.study-content').scrollTop=0;
  setTimeout(()=>Object.values(charts).forEach(c=>c&&c.resize()),50);
}
function getColors(){return{grid:isDark()?'rgba(255,255,255,0.05)':'rgba(0,0,0,0.04)',text:isDark()?'#636366':'#aeaeb2',tooltipBg:isDark()?'#1e1e25':'#fff',tooltipText:isDark()?'#f5f5f7':'#1d1d1f',tooltipBorder:isDark()?'rgba(255,255,255,0.1)':'rgba(0,0,0,0.1)'};}
function chartOpts(yFmt,xFmt){
  const c=getColors();
  return{responsive:true,maintainAspectRatio:false,animation:{duration:200},
    plugins:{legend:{position:'top',align:'center',labels:{color:c.text,font:{size:11,family:'DM Sans'},usePointStyle:true,pointStyleWidth:10,padding:14,boxHeight:8}},
      tooltip:{backgroundColor:c.tooltipBg,titleColor:c.text,bodyColor:c.tooltipText,borderColor:c.tooltipBorder,borderWidth:1,padding:12}},
    scales:{x:{grid:{color:c.grid},ticks:{color:c.text,font:{size:10,family:'DM Sans'},maxTicksLimit:9,callback:xFmt},border:{display:false}},
      y:{grid:{color:c.grid},ticks:{color:c.text,font:{size:10,family:'DM Sans'},callback:yFmt},border:{display:false}}}};
}
const K1=95.875,K2=96.00,COST=3,LOTS=10,BPV=25,W=(K2-K1)*100;
const payBp=f=>Math.min(Math.max((f-K1)*100,0),W);
const money=v=>(v<0?'−$':'+$')+Math.abs(Math.round(v)).toLocaleString();

function buildPay(){
  const xs=[];for(let f=95.70;f<=96.2501;f+=0.005)xs.push(+f.toFixed(3));
  const sc=[[95.791,'Hike, more signalled'],[95.870,'Hike, "last one"'],[95.988,'Hold, Jan hike priced'],[96.080,'Hold, pause']];
  const o=chartOpts(v=>'$'+(+v).toLocaleString(),v=>(+v).toFixed(2));
  Object.assign(o.scales.x,{type:'linear',min:95.70,max:96.25});
  charts.pay=new Chart($('chartPay'),{type:'line',data:{datasets:[
    {label:'P&L, 10 spreads',data:xs.map(f=>({x:f,y:(payBp(f)-COST)*BPV*LOTS})),borderColor:'#059669',borderWidth:2.5,pointRadius:0,tension:0},
    {label:'Scenarios',data:sc.map(s=>({x:s[0],y:(payBp(s[0])-COST)*BPV*LOTS})),borderColor:'#7c3aed',backgroundColor:'#7c3aed',pointRadius:5,showLine:false},
    {label:'Today (95.82)',data:[{x:95.82,y:(payBp(95.82)-COST)*BPV*LOTS}],borderColor:'#94a3b8',backgroundColor:'#94a3b8',pointRadius:5,showLine:false},
    {label:'Selected',data:[],borderColor:'#d97706',backgroundColor:'#d97706',pointRadius:7,showLine:false}
  ]},options:o});
  updPay();
}
function updPay(){
  const f=+$('p-f').value,bp=payBp(f),usd=(bp-COST)*BPV*LOTS;
  $('p-f-v').textContent=f.toFixed(3);$('p-r').textContent=(100-f).toFixed(3)+'%';
  $('p-bp').textContent=bp.toFixed(1)+' bp';$('p-usd').textContent=money(usd);
  $('p-usd').style.color=usd>0?'var(--green)':'var(--red)';
  if(charts.pay){charts.pay.data.datasets[3].data=[{x:f,y:usd}];charts.pay.update();}
}
$('p-f').addEventListener('input',updPay);

function buildEV(){
  const o=chartOpts(v=>'$'+Math.round(v));
  o.plugins.legend.display=false;
  charts.ev=new Chart($('chartEV'),{type:'bar',data:{labels:['Market odds (10%)','Your odds'],datasets:[{data:[0,0],backgroundColor:['#94a3b8','#059669'],borderRadius:6}]},options:o});
  updEV();
}
function updEV(){
  const p=$('e-p').value/100,c=+$('e-c').value;
  $('e-p-v').textContent=Math.round(p*100)+'%';$('e-c-v').textContent=c.toFixed(2)+' bp';
  const ev=q=>(q*(W-c)-(1-q)*c)*BPV*LOTS;
  $('e-be').textContent=(c/W*100).toFixed(0)+'%';
  $('e-me').textContent=money(ev(p));$('e-me').style.color=ev(p)>0?'var(--green)':'var(--red)';
  $('e-mk').textContent=money(ev(0.10));$('e-mk').style.color=ev(0.10)>0?'var(--green)':'var(--red)';
  if(charts.ev){const d=charts.ev.data;d.labels[1]='Your odds ('+Math.round(p*100)+'%)';d.datasets[0].data=[ev(0.10),ev(p)];
    d.datasets[0].backgroundColor=['#94a3b8',ev(p)>0?'#059669':'#dc2626'];charts.ev.update();}
}
['e-p','e-c'].forEach(id=>$(id).addEventListener('input',updEV));

function buildAll(){Object.keys(charts).forEach(k=>{charts[k].destroy();delete charts[k];});buildPay();buildEV();}
// Redraw the charts in the right colours when the site's theme changes
document.addEventListener('themechange',buildAll);

buildAll();
</script>
