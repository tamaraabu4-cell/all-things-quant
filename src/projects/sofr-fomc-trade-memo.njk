    <!-- ════════════ 1: SUMMARY ════════════ -->
    <div class="topic-pane" id="topic-1">
    <div class="topic-eyebrow">
      <span class="badge badge-accent">Trade Memo &middot; Rates</span>
      <span class="badge badge-subtle">Paper trade &middot; not investment advice</span>
