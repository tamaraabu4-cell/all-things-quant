{# Knowledge hub topic icons: same style as the homepage icons (24×24, thin round lines, coloured by CSS) #}
{% macro hubIcon(name, size=30) %}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {% if name == "maths" %}
    <path d="M4 4v16h16"></path><path d="M7 16c2-8 4-10 6-6s3 3 6-4"></path>
  {% elif name == "probability" %}
    <path d="M3 20h18"></path><path d="M3 19c3 0 4-13 9-13s6 13 9 13"></path><line x1="12" y1="6" x2="12" y2="20"></line>
  {% elif name == "valuation" %}
    <line x1="12" y1="3" x2="12" y2="21"></line><line x1="8" y1="21" x2="16" y2="21"></line><line x1="4" y1="7" x2="20" y2="7"></line><path d="M4 7l-2.5 6a2.5 2.5 0 0 0 5 0z"></path><path d="M20 7l-2.5 6a2.5 2.5 0 0 0 5 0z"></path>
  {% elif name == "markets" %}
    <path d="M3 21h18"></path><path d="M3 17l5-5 4 3 8-8"></path><path d="M14 7h6v6"></path>
  {% elif name == "macro" %}
    <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9s1.3-6.5 3.8-9z"></path>
  {% elif name == "trading" %}
    <path d="M7 20V5"></path><path d="M3 9l4-4 4 4"></path><path d="M17 4v15"></path><path d="M13 15l4 4 4-4"></path>
  {% elif name == "quant" %}
    <path d="M8 4H5v16h3"></path><path d="M16 4h3v16h-3"></path><path d="M8 15l3-3 2 2 3-4"></path>
  {% elif name == "code" %}
    <rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M7 9l3 3-3 3"></path><line x1="12" y1="15" x2="16" y2="15"></line>
  {% elif name == "realestate" %}
    <path d="M4 11l8-6 8 6"></path><path d="M6 9.5V16h12V9.5"></path><path d="M10 16v-4h4v4"></path><path d="M3 20c1.5 0 1.5-1 3-1s1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1"></path>
  {% elif name == "fintech" %}
    <circle cx="12" cy="12" r="9"></circle><path d="M9 16V8l6 8V8"></path><line x1="7.5" y1="11" x2="16.5" y2="11"></line><line x1="7.5" y1="13" x2="16.5" y2="13"></line>
  {% elif name == "simulations" %}
    <rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"></path><path d="M3 12.5h18"></path><path d="M11 12.5v1.5h2v-1.5"></path>
  {% endif %}
</svg>
{% endmacro %}