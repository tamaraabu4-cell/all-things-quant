<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <span class="footer-heading">Projects</span>
        <a href="/projects/projects.html">All projects</a>
      </div>
      <div class="footer-col">
        <span class="footer-heading">Knowledge Hub</span>
        <a href="/hub/">All notes</a>
      </div>
      <div class="footer-col">
        <span class="footer-heading">Blog</span>
        <a href="/blog/blog.html">All posts</a>
      </div>
      <div class="footer-col">
        <span class="footer-heading">Connect</span>
        {% if site.cv %}<a href="{{ site.cv }}">CV</a>{% endif %}
        {% if site.linkedin %}<a href="{{ site.linkedin }}">LinkedIn</a>{% endif %}
        {% if site.email %}<a href="mailto:{{ site.email }}">Email</a>{% endif %}
        <a href="{{ site.github }}">GitHub</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="footer-colophon">{{ site.name }} · est. 2026 · London — Lagos</span>
      <span>Paper trades and research only, not investment advice.</span>
    </div>
  </div>
</footer>