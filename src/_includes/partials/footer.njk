<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
            <div class="footer-col">
        <span class="footer-heading">Projects</span>
        <a href="/projects/projects.html">All projects</a>
        {% for project in projects.slice(0, 3) %}
        <a href="{{ project.url }}">{{ project.title }}</a>
        {% endfor %}
      </div>
            <div class="footer-col">
        <span class="footer-heading">Knowledge Hub</span>
        <a href="/study-guide/study-guide.html">All notes</a>
        {% if collections.notes %}
          {% set latestNotes = collections.notes | reverse %}
          {% for note in latestNotes.slice(0, 3) %}
          <a href="{{ note.url }}">{{ note.data.title }}</a>
          {% endfor %}
        {% endif %}
      </div>
            <div class="footer-col">
        <span class="footer-heading">Blog</span>
        <a href="/blog/blog.html">All posts</a>
        {% if collections.posts %}
          {% set latestPosts = collections.posts | reverse %}
          {% for post in latestPosts.slice(0, 3) %}
          <a href="{{ post.url }}">{{ post.data.title }}</a>
          {% endfor %}
        {% endif %}
      </div>
      <div class="footer-col">
        <span class="footer-heading">Connect</span>
        {% if site.cv %}<a href="{{ site.cv }}">CV</a>{% endif %}
        {% if site.linkedin %}<a href="{{ site.linkedin }}">LinkedIn</a>{% endif %}
        {% if site.email %}<a href="mailto:{{ site.email }}">Email</a>{% endif %}
        <a href="{{ site.github }}">GitHub</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{{ site.name }} · {{ site.year }} · Built in public</span>
      <span>Paper trades and research only, not investment advice.</span>
    </div>
  </div>
</footer>