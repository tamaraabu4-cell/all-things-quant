{% macro icon(name, size=44) %}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {% if name == "foundations" %}
    <path d="M12 3l9 4.5-9 4.5-9-4.5 9-4.5z"></path><path d="M3 12l9 4.5 9-4.5"></path><path d="M3 16.5l9 4.5 9-4.5"></path>
  {% elif name == "trading" %}
    <line x1="6" y1="3" x2="6" y2="21"></line><rect x="4" y="7" width="4" height="8" rx="1"></rect><line x1="12" y1="2" x2="12" y2="20"></line><rect x="10" y="5" width="4" height="10" rx="1"></rect><line x1="18" y1="5" x2="18" y2="22"></line><rect x="16" y="10" width="4" height="7" rx="1"></rect>
  {% elif name == "quant" %}
    <circle cx="5" cy="6" r="2"></circle><circle cx="5" cy="18" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="19" cy="6" r="2"></circle><circle cx="19" cy="18" r="2"></circle><path d="M7 7l3 3.5M7 17l3-3.5M14 10.5L17 7M14 13.5l3 3.5"></path>
  {% elif name == "realestate" %}
    <path d="M3 11l9-7 9 7"></path><path d="M5 9.5V20h14V9.5"></path><path d="M10 20v-6h4v6"></path>
  {% elif name == "fintech" %}
    <rect x="6" y="2" width="12" height="20" rx="2"></rect><path d="M9 8h6l-2-2"></path><path d="M15 12H9l2 2"></path><line x1="11" y1="18" x2="13" y2="18"></line>
  {% endif %}
</svg>
{% endmacro %}