---
layout: layouts/base.njk
---
{#
  Knowledge Hub note page.
  Every file in src/hub/notes uses this layout (see notes.11tydata.json).
  The note file supplies the sections; this layout adds everything around them:
  the chapter rail, header, Check yourself, connected notes, My notes, and the
  finishing card. note.js brings it all to life.
#}
{% set ctx = { shelf: shelf, subtopic: subtopic, themes: themes } | noteContext(page.url, collections.hubNote, shelves) %}
{% set nextNote = ctx.next if ctx else null %}

<div class="note-page{% if ctx and ctx.shelf.colour %} tone-{{ ctx.shelf.colour }}{% endif %}">
<div class="note-shell">

  {# ---------- Left rail: this chapter's notes, with this note's sections ---------- #}
  <aside class="note-rail" aria-label="Chapter contents">
    {% if ctx %}
    <div class="rail-head">
      <span class="rail-lbl">Chapter {{ ctx.chapter.num }}</span>
      <a class="rail-chapter" href="{{ ctx.shelf.url }}">{{ ctx.chapter.title }}</a>
    </div>
    <ul class="rail-notes">
      {% for item in ctx.items %}
        {% if item.url == page.url %}
        <li>
          <a class="rail-note current" href="#top" aria-current="page"><span class="dot"></span>{{ item.title }}</a>
          <ol class="secs" id="toc"></ol>
        </li>
        {% elif item.kind == "written" %}
        <li><a class="rail-note" href="{{ item.url }}" data-progress="{{ item.url }}"><span class="dot"></span>{{ item.title }}</a></li>
        {% else %}
        <li><span class="rail-note planned" title="Not written yet"><span class="dot"></span>{{ item.title }}</span></li>
        {% endif %}
      {% endfor %}
    </ul>
    {% endif %}
    <div class="rail-foot">
      <div class="rail-bar"><span id="rail-bar"></span></div>
      <span class="rail-small" id="rail-where">Section 1</span>
      <button class="btn-note" type="button" id="rail-notes" aria-controls="drawer">My notes <span class="count" id="rail-count"></span></button>
      <button class="btn-note" type="button" id="done-rail" data-done>Mark as done</button>
      <p class="done-hint" id="hint-rail" hidden></p>
    </div>
  </aside>

  {# ---------- The note ---------- #}
  <div class="note-main" id="top">
    <div class="note-inner">

      <div class="note-top">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/hub/">Knowledge hub</a><span aria-hidden="true">/</span>
          {% if ctx %}<a href="{{ ctx.shelf.url }}">{{ ctx.shelf.name }}</a><span aria-hidden="true">/</span>{% endif %}
          <span aria-current="page">{{ title }}</span>
        </nav>
        <a class="hub-lock" href="/api/lock" title="Lock the hub and sign out">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
          Lock
        </a>
      </div>

      <header class="note-head">
        {% if ctx %}<p class="note-kicker">{{ ctx.shelf.name }} · Chapter {{ ctx.chapter.num }} · {{ ctx.subtopic }}</p>{% endif %}
        <h1 class="note-title">{{ title }}</h1>
        {% if lede %}<p class="note-lede">{{ lede | safe }}</p>{% endif %}
        <div class="note-meta">
          {% if ctx %}<span class="chip-tone">Note {{ ctx.index + 1 }} of {{ ctx.total }}</span>{% endif %}
          {% if ctx %}{% for t in ctx.themes %}
          <a class="theme-link{% if t.colour %} tone-{{ t.colour }}{% endif %}" href="{{ t.url }}">{{ t.name }}</a>
          {% endfor %}{% endif %}
        </div>
      </header>

      <details class="mobile-contents">
        <summary>Contents</summary>
        <ol id="toc-mobile"></ol>
      </details>

      {{ content | safe }}

      {% if quiz %}
      <section class="sec" id="check" data-sec data-title="Check yourself" data-check>
        <div class="sec-head">
          <div class="sec-top"><span class="sec-num">✓</span></div>
          <h2>Check yourself</h2>
          <p class="sec-q">{{ quiz | length }} quick questions before you mark it done. <span class="quiz-status" id="quiz-status"></span></p>
        </div>
        <div class="quiz" id="quiz"></div>
      </section>
      {% endif %}

      {% if connected or nextNote %}
      <section class="connected" aria-label="Connected notes">
        <h2>Connected notes</h2>
        <div class="links">
          {% for c in connected %}
          <a class="link-card" href="{{ c.url or '#' }}"><span class="k">{{ c.label }}</span><span class="t">{{ c.title | safe }}</span><span class="k">{{ c.where }}</span></a>
          {% endfor %}
          {% if nextNote %}
          <a class="link-card" href="{{ nextNote.url if nextNote.kind == 'written' else ctx.shelf.url }}"><span class="k">Next{% if nextNote.kind != 'written' %} · not written yet{% endif %}</span><span class="t">{{ nextNote.title }}</span><span class="k">{{ ctx.shelf.name }} · {{ ctx.chapter.title }}</span></a>
          {% endif %}
        </div>
      </section>
      {% endif %}

      <nav class="next-nav" aria-label="Next note">
        <a class="btn-note" href="{{ ctx.shelf.url if ctx else '/hub/' }}">← {{ ctx.shelf.name if ctx else 'Knowledge hub' }}</a>
        <span class="done-wrap"><button class="btn-note" type="button" id="done-bottom" data-done>Mark as done</button><span class="done-hint" id="hint-bottom" hidden></span></span>
        {% if nextNote and nextNote.kind == 'written' %}<a class="btn-note dark" href="{{ nextNote.url }}">Next: {{ nextNote.title }} →</a>{% endif %}
      </nav>
    </div>
  </div>
</div>

{# ---------- My notes: slides in from the right (a sheet from the bottom on phones) ---------- #}
<button class="notes-fab" type="button" id="notes-fab" aria-controls="drawer" aria-expanded="false">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
  My notes <span class="fab-count" id="fab-count"></span>
</button>

<aside class="drawer" id="drawer" aria-label="My notes" aria-hidden="true">
  <div class="drawer-head">
    <div><h2>My notes</h2><p>{{ title }} · <span id="drawer-count">0 entries</span></p></div>
    <button class="icon-btn" type="button" id="drawer-close" aria-label="Close my notes"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
  </div>
  <div class="drawer-body">
    <div class="journal-rules" id="j-rules" hidden>
      <span class="lbl">My rules for this note</span>
      <div id="j-rules-list" class="j-rules-list"></div>
    </div>
    <form class="composer" id="j-form" autocomplete="off">
      <label class="link-to"><span>Linked to</span><select id="j-sec"><option value="">Whole note</option></select></label>
      <div class="kinds" role="radiogroup" aria-label="Type of entry">
        <label><input type="radio" name="kind" value="note" checked><span>Note</span></label>
        <label><input type="radio" name="kind" value="working"><span>Working</span></label>
        <label><input type="radio" name="kind" value="rule"><span>Rule</span></label>
      </div>
      <span class="hint" id="j-hint"></span>
      <label class="sr-only" for="j-text">Your entry</label>
      <textarea id="j-text" rows="4" placeholder="Type here. Press a maths button and type over the highlighted letter."></textarea>
      <div class="tex-bar" aria-label="Insert maths">
        <button type="button" data-tpl="[x]" title="Maths">\(x\)</button>
        <button type="button" data-tpl="[a]^{[n]}" title="Power">\(a^{n}\)</button>
        <button type="button" data-tpl="[a]_{[i]}" title="Subscript">\(a_{i}\)</button>
        <button type="button" data-tpl="\frac{[a]}{[b]}" title="Fraction">\(\frac{a}{b}\)</button>
        <button type="button" data-tpl="\sqrt{[x]}" title="Square root">\(\sqrt{x}\)</button>
        <button type="button" data-tpl="\left([x]\right)" title="Brackets">\(\left(x\right)\)</button>
        <button type="button" data-tpl="\times " title="Times">\(\times\)</button>
        <button type="button" data-tpl="\approx " title="Approximately">\(\approx\)</button>
        <button type="button" data-tpl="\text{£}" title="Pound sign">\(\text{£}\)</button>
      </div>
      <div class="preview-wrap">
        <span class="lbl">Preview</span>
        <div class="preview" id="j-preview" aria-live="polite"><span class="muted">Your entry will appear here as you type.</span></div>
      </div>
      <div class="composer-actions">
        <button type="button" class="btn-note ghost" id="j-cancel" hidden>Cancel edit</button>
        <button type="submit" class="btn-note dark" id="j-save">Add to my notes</button>
      </div>
      <p class="form-error" id="j-error" hidden>Write something first.</p>
    </form>
    <div class="filter" role="group" aria-label="Show entries">
      <button type="button" data-f="all" aria-pressed="true">All</button>
      <button type="button" data-f="here" aria-pressed="false" id="f-here">This section</button>
    </div>
    <div class="entries" id="j-list"></div>
  </div>
</aside>

{# ---------- Shown when the note is marked as done ---------- #}
<div class="complete" id="complete" role="status" aria-live="polite" hidden>
  <div class="complete-card">
    <svg class="tick" viewBox="0 0 52 52" aria-hidden="true"><circle class="tick-ring" cx="26" cy="26" r="23"></circle><path class="tick-mark" d="M15 27l7.5 7.5L37.5 19"></path></svg>
    <div class="complete-text">
      <span class="complete-lbl">Note complete</span>
      <strong>{{ title }}</strong>
      {% if ctx %}<div class="complete-progress"><span class="cp-bar"><span id="cp-fill"></span></span><span class="cp-text" id="cp-text"></span></div>{% endif %}
      <span class="complete-small">It'll come back for a quick revisit in a week.</span>
    </div>
    <div class="complete-actions">
      {% if nextNote and nextNote.kind == 'written' %}
      <a class="btn-note dark" href="{{ nextNote.url }}">Next: {{ nextNote.title }} →</a>
      {% elif ctx %}
      <a class="btn-note dark" href="{{ ctx.shelf.url }}">Back to {{ ctx.shelf.name }} →</a>
      {% endif %}
      <button class="btn-note" type="button" id="complete-close">Close</button>
    </div>
  </div>
</div>

</div>{# end .note-page #}

{# ---------- Data for note.js ---------- #}
<script id="note-data" type="application/json">{{ {
  url: page.url,
  title: title,
  quiz: quiz or [],
  chapterTitle: ctx.chapter.title if ctx else "",
  chapterNotes: ctx.items if ctx else []
} | dump | safe }}</script>
<script id="glossary-data" type="application/json">{{ glossary | dump | safe }}</script>

{# Maths: every \( ... \) and \[ ... \] on the page is typeset by MathJax #}
<script>
  window.MathJax = {
    tex: { inlineMath: [["\\(", "\\)"]], displayMath: [["\\[", "\\]"]] },
    svg: { fontCache: "global" }
  };
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-svg.js" defer></script>
<script src="/assets/js/note.js" defer></script>
{% for src in noteScripts %}<script src="{{ src }}" defer></script>
{% endfor %}