<section class="highlights">
  <div class="container">
    <h2 class="section-title">Get the highlights.</h2>
  </div>
  <div class="carousel" role="region" aria-label="Highlights from across the site, scroll sideways" tabindex="0">
    {% for item in highlights %}
    {# Each card takes the colour of its "topic" (a slug from shelves.json) #}
    <a class="highlight-card{% for s in shelves %}{% if s.slug == item.topic and s.colour %} tone-{{ s.colour }}{% endif %}{% endfor %}" href="{{ item.url }}">
      <span class="card-top">
        <span class="card-tag">{{ item.tag }}</span>
        <span class="card-headline">{{ item.headline }}</span>
      </span>
      <span class="card-bottom">
        {% if item.points %}
          {% for point in item.points %}
          <span class="card-point">{{ point }}</span>
          {% endfor %}
        {% endif %}
        <span class="card-cta">{{ item.cta }} ›</span>
      </span>
    </a>
    {% endfor %}
  </div>
</section>