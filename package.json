{
  "name": "heritage-edge",
  "version": "1.0.0",
  "description": "Heritage Edge is my own personal website of trading ideas, built with code. It acts as both a portfolio and knowledge hub on markets, trading, and the technology that is changing how both work.",
  "main": "index.js",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy && npm run index",
    "index": "pagefind --site _site --glob \"{index.html,about/**/*.html,blog/**/*.html,projects/**/*.html}\" && pagefind --site _site --glob \"hub/**/*.html\" --output-path _site/hub/_pagefind",
    "preview": "npm run build && pagefind --site _site --glob \"hub/**/*.html\" --output-path _site/hub/_pagefind --serve"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamaraabu4-cell/heritage-edge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/tamaraabu4-cell/heritage-edge/issues"
  },
  "homepage": "https://github.com/tamaraabu4-cell/heritage-edge#readme",
  "dependencies": {
    "@11ty/eleventy": "^3.1.7",
    "pagefind": "^1.3.0"
  }
}
